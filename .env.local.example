# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Painel do Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-public-aqui

# Chave de administrador do Supabase (Project Settings > API > service_role)
# NUNCA compartilhe essa chave nem coloque ela no código — só em variável de ambiente.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Endereço público do site (sem barra no final) — usado nos links de e-mail e no Mercado Pago
NEXT_PUBLIC_SITE_URL=https://boi-no-cocho-jardon2211-7202.vercel.app

# Token de integração do PagBank (painel do PagBank > Minha Conta > Token de
# Segurança / Integrações). É o mesmo token usado pra validar a assinatura
# dos webhooks, então precisa ser exatamente esse valor, sem espaços extras.
PAGBANK_TOKEN=seu-token-de-integracao-aqui

# Link de pagamento fixo criado uma vez no painel do PagBank (Cobrar > Link de
# Pagamento). Esse é o link que o botão "Comprar" do site usa.
NEXT_PUBLIC_PAGBANK_PAYMENT_LINK=https://pag.ae/SEU_CODIGO_AQUI
